{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FuzMods",
  "version": "1.1.0",
  "identifier": "com.fuzion28.fuzmods",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FuzMods",
        "width": 1040,
        "height": 680,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://github.com https://*.githubusercontent.com data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
